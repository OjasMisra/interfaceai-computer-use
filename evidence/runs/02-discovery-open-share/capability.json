      "name": "member_number",
      "type": "string",
      "description": "Member (account holder) number",
      "required": true,
      "pattern": "\\d{5,9}",
      "enum": null,
      "minimum": null,
      "sensitivity": "pii"
    },
    {
      "name": "opening_deposit",
      "type": "decimal",
      "description": "Opening deposit amount in USD",
      "required": true,
      "pattern": null,
      "enum": null,
      "minimum": "0.01",
      "sensitivity": "pii"
    },
    {
      "name": "share_type",
      "type": "enum",
      "description": "Type of share to open",
      "required": true,
      "pattern": null,
      "enum": [
        "\u00abshare_type\u00bb",
        "CLUB",
        "CERTIFICATE"
      ],
      "minimum": null,
      "sensitivity": "internal"
    }
  ],
  "outputs": [
    {
      "name": "confirmation_number",
      "type": "string",
      "description": "Host confirmation number",
      "required": true,
      "sensitivity": "internal"
    },
    {
      "name": "share_id",
      "type": "string",
      "description": "Id of the newly opened share",
      "required": true,
      "sensitivity": "internal"
    }
  ],
